generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String
  kindeId          String    @unique @map("kinde_id")
  stripeCustomerId String    @unique @map("stripe_customer_id")
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  subscriptions Subscription[]
  apiUsage      ApiUsage[]
  Contact       Contact[]

  @@map("users")
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @map("user_id")
  stripeSubscriptionId String    @unique @map("stripe_subscription_id")
  status               String // active, canceled, past_due, trialing, incomplete, incomplete_expired
  currentPeriodStart   DateTime  @map("current_period_start")
  currentPeriodEnd     DateTime  @map("current_period_end")
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")
  productId            String    @map("product_id")
  priceId              String    @map("price_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  canceledAt           DateTime? @map("canceled_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("subscriptions")
}

model StripeWebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique @map("stripe_event_id")
  eventType     String   @map("event_type")
  processedAt   DateTime @default(now()) @map("processed_at")
  data          Json? // オプション: イベントデータを保存する場合

  @@index([eventType])
  @@map("stripe_webhook_events")
}

model Waitlist {
  id         String    @id @default(cuid())
  email      String    @unique
  createdAt  DateTime  @default(now()) @map("created_at")
  releasedAt DateTime? @map("released_at")
  status     String    @default("waiting") // waiting / invited / joined など

  @@map("waitlists")
}

model ApiUsage {
  id                  String   @id @default(cuid())
  userId              String   @map("user_id")
  createdAt           DateTime @default(now()) @map("created_at")
  locale              String
  translationLanguage String?  @map("translation_language")
  inputLength         Int      @map("input_length")
  recentInputLength   Int      @map("recent_input_length")
  contextLength       Int?     @map("context_length")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("api_usage")
}

model Contact {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("contacts")
}
